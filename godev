            else
                printf "${GREEN}✓ %-10s${NC} " "$project_status"
            fi

            # Indicador de actividad
            local bars=""
            if (( activity > 20 )); then
                bars="${GREEN}●●●${NC}"
            elif (( activity > 5 )); then
                bars="${YELLOW}●●○${NC}"
            elif (( activity > 0 )); then
                bars="${GRAY}●○○${NC}"
            else
                bars="${GRAY}○○○${NC}"
            fi

            printf "%b (%-3s)" "$bars" "$activity"

            if [[ "$show_remote" == "true" ]]; then
                 printf " %-40s\n" "$remote"
            else
                 printf "\n"
            fi
            ((with_git++))
        else
            if [[ "$show_remote" == "true" ]]; then
                printf "${GRAY}%-20s %-15s %-12s %-15s %-40s${NC}\n" "NO_GIT" "N/A" "N/A" "○○○" ""
            else
                printf "${GRAY}%-20s %-15s %-12s %-15s${NC}\n" "NO_GIT" "N/A" "N/A" "○○○"
            fi
        fi

        ((total++))
    done < <(scan_projects "$GODEV_BASE_DIR")

    if [[ "$show_remote" == "true" ]]; then
        printf "%s\n" "──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
    else
        printf "%s\n" "────────────────────────────────────────────────────────────────────────────────────────────────────"
    fi

    if [[ $total -eq 0 ]]; then
        echo ""
        echo "${YELLOW}⚠ No projects found matching '${search}'${NC}"
        echo ""
        return 1
    fi

    echo ""
    echo "${BOLD}Total: $total project(s)${NC}"
    echo ""
    return 0
}

tree_projects() {
    local search="$1"
    load_config || return 1

    local clean_base="${GODEV_BASE_DIR%/}"
    local -a matched_dirs

    while IFS= read -r project; do
        local name="${project#$clean_base/}"
        if [[ -n "$search" ]] && [[ ! "${name:l}" == *"${search:l}"* ]]; then
            continue
        fi
        matched_dirs+=("$project")
    done < <(scan_projects "$GODEV_BASE_DIR")

    if [[ ${#matched_dirs[@]} -eq 0 ]]; then
        echo ""
        echo "${YELLOW}⚠ No projects found${search:+ matching '$search'}${NC}"
        echo ""
        return 1
    fi

    # Build a temp directory structure with symlinks for tree display
    local tmpdir=$(mktemp -d)
    for dir in "${matched_dirs[@]}"; do
        local rel="${dir#$clean_base/}"
        local parent="${tmpdir}/${rel%/*}"
        if [[ "$rel" == */* ]]; then
            mkdir -p "$parent"
            ln -s "$dir" "$tmpdir/$rel" 2>/dev/null
        else
            ln -s "$dir" "$tmpdir/$rel" 2>/dev/null
        fi
    done

    echo ""
    if [[ -n "$search" ]]; then
        echo "${BOLD}${CYAN}Projects matching '${search}':${NC}"
    else
        echo "${BOLD}${CYAN}Project tree:${NC}"
    fi
    echo "${BOLD}${clean_base}${NC}"

    if command -v tree &> /dev/null; then
        tree -C -L 2 --dirsfirst -I '.git' "$tmpdir" | tail -n +2
    else
        # Fallback without tree command
        local prev_group=""
        for dir in "${matched_dirs[@]}"; do
            local rel="${dir#$clean_base/}"
            if [[ "$rel" == */* ]]; then
                local group="${rel%%/*}"
                local leaf="${rel#*/}"
                if [[ "$group" != "$prev_group" ]]; then
                    echo "${CYAN}├── ${group}/${NC}"
                    prev_group="$group"
                fi
                echo "${GRAY}│   ├── ${NC}${leaf}"
            else
                echo "${CYAN}├── ${rel}${NC}"
            fi
        done
        echo "${CYAN}└──${NC}"
    fi

    echo ""
    echo "${BOLD}Total: ${#matched_dirs[@]} project(s)${NC}"
    echo ""

    rm -rf "$tmpdir"
    return 0
}

