HTML_CACHE_FILE="$CONFIG_DIR/projects.html"

html_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    s="${s//\"/&quot;}"
    print -r -- "$s"
}

# Convert a git remote URL to a clickable web URL (empty if not possible)
remote_to_web_url() {
    local r="$1"
    case "$r" in
        git@*)
            local host="${r#git@}"
            host="${host%%:*}"
            local repo_path="${r#git@*:}"
            repo_path="${repo_path%.git}"
            echo "https://${host}/${repo_path}"
            ;;
        ssh://git@*)
            local rest="${r#ssh://git@}"
            rest="${rest%.git}"
            echo "https://${rest}"
            ;;
        http://*|https://*)
            echo "${r%.git}"
            ;;
        *)
            echo ""
            ;;
    esac
}

generate_html_cache() {
    load_config || return 1

    local clean_base="${GODEV_BASE_DIR%/}"
    local total=0
    local with_git=0
    local modified=0
    local rows=""

    echo "${CYAN}Escaneando proyectos...${NC}" >&2

    local -a projects_data
    while IFS= read -r project; do
        local name="${project#$clean_base/}"
        local git_raw=$(get_git_info "$project")
        local has_git=$(echo "$git_raw" | grep -o "has_git:[^|]*" | cut -d: -f2)

        local last_commit="—"
        local branch="—"
        local project_status="no git"
        local activity="0"
        local remote=""

        if [[ "$has_git" == "true" ]]; then
            last_commit=$(echo "$git_raw" | grep -o "last_commit:[^|]*" | cut -d: -f2-)
            branch=$(echo "$git_raw" | grep -o "branch:[^|]*" | cut -d: -f2)
            project_status=$(echo "$git_raw" | grep -o "status:[^|]*" | cut -d: -f2)
            activity=$(echo "$git_raw" | grep -o "activity:[^|]*" | cut -d: -f2)
            remote=$(echo "$git_raw" | grep -o "remote:[^|]*" | cut -d: -f2-)
            [[ "$remote" == "no_remote" ]] && remote=""

            ((with_git++))
            [[ "$project_status" == "modified" ]] && ((modified++))
        fi

        projects_data+=("$name|$has_git|$last_commit|$branch|$project_status|$activity|$remote|$project")
        ((total++))
    done < <(scan_projects "$GODEV_BASE_DIR")

    # Build table rows (alphabetical order)
    (( total > 0 )) && while IFS='|' read -r name has_git last_commit branch project_status activity remote project_path; do
        local esc_name=$(html_escape "$name")
        local esc_path=$(html_escape "$project_path")

        local status_html=""
        if [[ "$has_git" != "true" ]]; then
            status_html='<span class="badge nogit">no git</span>'
        elif [[ "$project_status" == "modified" ]]; then
            status_html='<span class="badge modified">&#9679; modified</span>'
        else
            status_html='<span class="badge clean">&#10003; clean</span>'
        fi

        local activity_html="—"
        if [[ "$has_git" == "true" ]]; then
            local dots=""
            if (( activity > 20 )); then dots='<span class="act high">&#9679;&#9679;&#9679;</span>'
            elif (( activity > 5 )); then dots='<span class="act mid">&#9679;&#9679;&#9675;</span>'
            elif (( activity > 0 )); then dots='<span class="act low">&#9679;&#9675;&#9675;</span>'
            else dots='<span class="act none">&#9675;&#9675;&#9675;</span>'
            fi
            activity_html="${dots} <span class=\"muted\">(${activity})</span>"
        fi

        local remote_html='<span class="muted">—</span>'
        if [[ -n "$remote" ]]; then
            local web_url=$(remote_to_web_url "$remote")
            local esc_remote=$(html_escape "$remote")
            if [[ -n "$web_url" ]]; then
                remote_html="<a href=\"$(html_escape "$web_url")\" target=\"_blank\" rel=\"noopener\">${esc_remote}</a>"
            else
                remote_html="<span class=\"mono\">${esc_remote}</span>"
            fi
        fi

        local branch_html="—"
        [[ "$has_git" == "true" ]] && branch_html="<span class=\"mono branch\">$(html_escape "$branch")</span>"

        # Repo description from local git config (git config --local repo.description)
        local description_html='<span class="muted">—</span>'
        if [[ "$has_git" == "true" ]]; then
            local description=$(git -C "$project_path" config --local repo.description 2>/dev/null)
            [[ -n "$description" ]] && description_html="$(html_escape "$description")"
        fi

        rows+="<tr>
<td><a class=\"project\" href=\"file://${esc_path}\" title=\"${esc_path}\">${esc_name}</a></td>
<td>${last_commit}</td>
<td>${branch_html}</td>
<td>${status_html}</td>
<td>${activity_html}</td>
<td class=\"remote\">${remote_html}</td>
<td class=\"description\">${description_html}</td>
</tr>
"
    done < <(printf "%s\n" "${projects_data[@]}" | sort -t'|' -k1)

    local generated_at=$(date "+%Y-%m-%d %H:%M:%S")

    mkdir -p "$CONFIG_DIR"
    cat > "$HTML_CACHE_FILE" <<EOF
