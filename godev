# Descarga una URL a un archivo. Usa curl o wget. Devuelve 0 si OK.
_download() {
    local url="$1" out="$2"
    if command -v curl &> /dev/null; then
        curl -fsSL --max-time 10 "$url" -o "$out" 2>/dev/null
    elif command -v wget &> /dev/null; then
        wget -q --timeout=10 "$url" -O "$out" 2>/dev/null
    else
        return 127
    fi
}

# Resuelve la última versión publicada. Imprime "version|ref" donde:
#   version = número sin la 'v' (ej. 2.6.0)
#   ref     = tag del release (ej. v2.6.0) o la rama de fallback (ej. main)
# El ref indica de dónde descargar, garantizando anunciado == instalado.
# Vacío si no se pudo resolver.
_resolve_remote() {
    local tmp tag raw_ver
    tmp=$(mktemp) || return 1

    # 1) Preferir el último GitHub Release; descargar desde su TAG
    if _download "https://api.github.com/repos/${GODEV_REPO}/releases/latest" "$tmp"; then
        tag=$(grep -m1 '"tag_name"' "$tmp" | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
        if [[ -n "$tag" ]]; then
            rm -f "$tmp"
            echo "${tag#v}|${tag}"
            return 0
        fi
    fi

    # 2) Fallback: raw de la rama (sólo si no hay releases publicados)
    if _download "https://raw.githubusercontent.com/${GODEV_REPO}/${GODEV_BRANCH}/godev" "$tmp"; then
        raw_ver=$(grep -m1 '^VERSION=' "$tmp" | sed -E 's/^VERSION="?([^"]+)"?.*/\1/')
        if [[ -n "$raw_ver" ]]; then
            rm -f "$tmp"
            echo "${raw_ver}|${GODEV_BRANCH}"
            return 0
        fi
    fi

    rm -f "$tmp"
    return 1
}

# Compara dos versiones semánticas. Devuelve 0 si $1 > $2 (hay update disponible).
_version_gt() {
    [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$1" ]]
}

# Determina cómo está instalado godev: "brew" o "standalone".
#
# NO se llama en el camino caliente (navegación): sólo desde --update y --version.
# El primer test es una comparación de strings (gratis); recién si falla se mira
# $HOMEBREW_PREFIX, y sólo como último recurso se lanza el proceso `brew`.
_install_kind() {
    # 1) El binario real vive dentro del Cellar de Homebrew
    if [[ "$GODEV_BIN_REAL" == */Cellar/godev/* ]]; then
        echo "brew"
        return 0
    fi

    # 2) Cuelga del prefix de Homebrew
    local prefix="$HOMEBREW_PREFIX"
    if [[ -z "$prefix" ]] && command -v brew &> /dev/null; then
        prefix=$(brew --prefix 2>/dev/null)
    fi
    if [[ -n "$prefix" ]] && [[ "$GODEV_BIN_REAL" == "${prefix}"/* || "$GODEV_BIN" == "${prefix}"/* ]]; then
        echo "brew"
        return 0
    fi

    echo "standalone"
    return 0
}

self_update() {
    if ! command -v curl &> /dev/null && ! command -v wget &> /dev/null; then
        echo "${RED}✗ You need curl or wget installed to update${NC}" >&2
        return 1
    fi

    echo "${CYAN}Checking GitHub for the latest version (${GODEV_REPO})...${NC}"

    local resolved remote_version remote_ref
    resolved=$(_resolve_remote)
    if [[ -z "$resolved" ]]; then
        echo "${RED}✗ Could not reach GitHub to look up the latest version${NC}" >&2
        return 1
    fi
    remote_version="${resolved%%|*}"
    remote_ref="${resolved##*|}"

    # Comparar
    if ! _version_gt "$remote_version" "$VERSION"; then
        echo "${GREEN}✓ Already on the latest version (${VERSION})${NC}"
        return 0
    fi

    echo ""
    echo "${BOLD}A new version is available:${NC} ${YELLOW}${VERSION}${NC} → ${GREEN}${remote_version}${NC}"

    # Bajo Homebrew, godev NO se auto-actualiza: el binario en $(brew --prefix)/bin
    # es un symlink al Cellar, y sobrescribirlo rompería la contabilidad de brew
    # (y el próximo `brew upgrade` borraría el cambio igual).
    if [[ "$(_install_kind)" == "brew" ]]; then
        echo ""
        echo "${CYAN}This install is managed by Homebrew.${NC} ${GRAY}(${GODEV_BIN})${NC}"
        echo "${BOLD}Upgrade with:${NC} ${GREEN}brew upgrade godev${NC}"
        echo ""
        echo "${GRAY}If the tap has not published ${remote_version} yet, refresh it first:${NC}"
        echo "${GRAY}  brew update${NC}"
        return 0
    fi

    echo -n "Update now? (y/N): "
    local answer
    read -k 1 answer < /dev/tty
    echo
    if [[ ! "$answer" =~ ^[yY]$ ]]; then
        echo "${CYAN}Update cancelled${NC}"
        return 0
    fi

    # Destino: el binario que se está ejecutando ahora mismo, no una ruta adivinada.
    # Antes esto era "$HOME/.local/bin/godev" fijo, lo que rompía cualquier
    # instalación fuera de ahí: descargaba la versión nueva al lado de la que
    # realmente corre y anunciaba éxito sin haber actualizado nada.
    local dest="$GODEV_BIN"
    local dest_dir="${dest:h}"
    if [[ ! -d "$dest_dir" ]]; then
        echo "${RED}✗ Install directory not found: $dest_dir${NC}" >&2
        return 1
    fi
    if [[ ! -w "$dest_dir" ]]; then
        echo "${RED}✗ No write permission in $dest_dir${NC}" >&2
        echo "${GRAY}  godev deliberately does not self-update with sudo.${NC}" >&2
        return 1
    fi

    # Descargar a temporal dentro del mismo directorio (mv atómico)
    local tmpfile
    tmpfile=$(mktemp "${dest_dir}/godev.new.XXXXXX") || {
        echo "${RED}✗ No se pudo crear archivo temporal en $dest_dir${NC}" >&2
        return 1
    }

    echo "${CYAN}Downloading godev ${remote_version} (${remote_ref})...${NC}"
    if ! _download "https://raw.githubusercontent.com/${GODEV_REPO}/${remote_ref}/godev" "$tmpfile"; then
        rm -f "$tmpfile"
        echo "${RED}✗ Download failed${NC}" >&2
        return 1
    fi

    # Validar: sintaxis y que sea realmente el script godev
    if ! zsh -n "$tmpfile" 2>/dev/null; then
        rm -f "$tmpfile"
        echo "${RED}✗ The downloaded file has syntax errors; aborting without touching your install${NC}" >&2
        return 1
    fi
    if ! grep -q '^VERSION=' "$tmpfile"; then
        rm -f "$tmpfile"
        echo "${RED}✗ The downloaded file does not look like godev; aborting${NC}" >&2
        return 1
    fi

    # Backup del binario actual (preservar información)
    if [[ -f "$dest" ]]; then
        local backup="${dest}.backup-$(date +%s)"
        cp "$dest" "$backup" && echo "${GRAY}Backup guardado en: ${backup}${NC}"
    fi

    # Reemplazo atómico
    chmod +x "$tmpfile"
    if ! mv "$tmpfile" "$dest"; then
        rm -f "$tmpfile"
        echo "${RED}✗ No se pudo reemplazar el binario en $dest${NC}" >&2
        return 1
    fi

    # Actualizar version_info
    cat > "$VERSION_FILE" << EOF
version=$remote_version
install_date=$(date +%s)
install_source=https://raw.githubusercontent.com/${GODEV_REPO}/${remote_ref}/godev
updated_via=self-update
EOF

    echo ""
    echo "${GREEN}${BOLD}✓ Updated to v${remote_version}${NC}"
    echo "${CYAN}Reload your shell to use the new version:${NC} source ~/.zshrc"
    return 0
}

# ============================================================================
# SHELL INIT (función wrapper)
# ============================================================================

# La línea que se cablea en ~/.zshrc y el comentario que la marca como nuestra.
GODEV_INIT_MARKER="# godev - shell integration (godev --init --install)"
# `command` es deliberado: si una función godev() vieja sigue definida en la
# sesión (p.ej. al sourcear .zshrc tras migrar), sin él la llamada la secuestra,
# el eval recibe vacío y la función vieja sobrevive. `command` va directo al PATH.
GODEV_INIT_LINE='eval "$(command godev --init zsh)"'

# Aliases del plugin `git` de oh-my-zsh que se romperían en silencio si se los
# pisa. La lista no pretende ser exhaustiva: cubre los de uso diario.
GODEV_OMZ_GIT_ALIASES=(ga gaa gb gba gbd gc gca gcb gcm gco gcp gd gda gds gf
                       gfa gl gla gm gp gpf gr grb grh gs gst gsw)

# Imprime la función wrapper de zsh a stdout. Se consume con:
#     eval "$(godev --init zsh)"
#
# La ruta del binario se resuelve ACÁ, en tiempo de generación, y queda embebida
# en la función. Usa GODEV_BIN (symlink sin resolver) a propósito: bajo Homebrew
# eso es $(brew --prefix)/bin/godev, que sobrevive a `brew upgrade`. La ruta del
# Cellar, en cambio, cambia con cada versión.
print_shell_init() {
    local shell_name="$1" alias_name="$2"

    if [[ -n "$shell_name" && "$shell_name" != "zsh" ]]; then
        echo "${RED}✗ godev --init only supports zsh (got: ${shell_name})${NC}" >&2
        echo "${GRAY}  godev needs zsh to change your shell directory.${NC}" >&2
        return 1
    fi

    cat << EOF
${GODEV_INIT_MARKER}
# Generated by 'godev --init zsh' — do not edit by hand.
godev() {
    local godev_bin="${GODEV_BIN}"
EOF
    cat << 'EOF'
    local result exit_code

    if [[ ! -x "$godev_bin" ]]; then
        print -u2 "godev: binary not found at $godev_bin"
        print -u2 "godev: regenerate the wrapper with: godev --init --install"
        return 127
    fi

    # Los comandos que empiezan con '-' no navegan: ejecutar y devolver
    if [[ "$1" == -* ]]; then
        "$godev_bin" "$@"
        return $?
    fi

    result=$("$godev_bin" "$@")
    exit_code=$?

    if [[ $exit_code -eq 0 && -d "$result" ]]; then
        cd "$result"
    else
        [[ -n "$result" ]] && print -r -- "$result"
        return $exit_code
    fi
}
EOF

    [[ -n "$alias_name" ]] && echo "alias ${alias_name}='godev'"
    return 0
}

# Lista otros ejecutables `godev` que no son el que se está ejecutando.
# Detecta el shadowing de PATH entre la copia de brew y la del instalador.
_godev_find_shadows() {
    local -a found
    local dir cand
    for dir in ${(s.:.)PATH}; do
        cand="$dir/godev"
        [[ -f "$cand" && -x "$cand" ]] || continue
        [[ "${cand:A}" == "$GODEV_BIN_REAL" ]] && continue
        (( ${found[(I)$cand]} )) || found+=("$cand")
    done
    # ~/.local/bin puede no estar en PATH y tener igual una copia vieja
    cand="$HOME/.local/bin/godev"
    if [[ -f "$cand" && -x "$cand" && "${cand:A}" != "$GODEV_BIN_REAL" ]]; then
        (( ${found[(I)$cand]} )) || found+=("$cand")
    fi
    print -l -- $found
}

# Avisa si el alias pedido pisaría algo. No decide: informa.
_godev_warn_alias_collision() {
    local name="$1" zshrc="$2"
    local existing collided=1

    existing=$(grep -n "^[[:space:]]*alias ${name}=" "$zshrc" 2>/dev/null | head -1)
    if [[ -n "$existing" ]]; then
        echo "${YELLOW}⚠ There is already a '${name}' alias in your .zshrc:${NC} ${GRAY}${existing}${NC}"
        collided=0
    fi

    if (( ${GODEV_OMZ_GIT_ALIASES[(I)$name]} )) && [[ -d "$HOME/.oh-my-zsh" ]]; then
        if grep -qE '^[[:space:]]*plugins=.*\bgit\b' "$zshrc" 2>/dev/null; then
            echo "${YELLOW}⚠ '${name}' is an alias from oh-my-zsh's git plugin, which you have enabled.${NC}"
            echo "${GRAY}  Defining it here shadows that silently: the original command stops working.${NC}"
            collided=0
        fi
    fi

    return $collided
}

# Cablea la línea de integración en ~/.zshrc, reemplazando el wrapper viejo.
install_shell_init() {
    local alias_name="$1" assume_yes="$2"
    local zshrc="$HOME/.zshrc"
    local -a plan
    local has_old_fn=1 has_init_line=1

    [[ -f "$zshrc" ]] || touch "$zshrc"

    grep -qE '^godev\(\) \{' "$zshrc" 2>/dev/null && has_old_fn=0
    grep -qE '^eval "\$\((command )?godev --init zsh\)"$' "$zshrc" 2>/dev/null && has_init_line=0

    # --- Plan ---------------------------------------------------------------
    echo ""
    echo "${BOLD}godev — zsh integration${NC}"
    echo ""
    echo "  Binary:  ${CYAN}${GODEV_BIN}${NC}"
    echo "  Target:  ${CYAN}${zshrc}${NC}"
    echo ""

    plan+=("Back up ~/.zshrc with a timestamp")
    (( has_old_fn == 0 )) && plan+=("Remove the previous godev() function (kept in the backup)")
    if (( has_init_line == 0 )); then
        plan+=("Regenerate the integration line (already present)")
    else
        plan+=("Add: ${GODEV_INIT_LINE}")
    fi

    echo "${BOLD}What will happen:${NC}"
    local step
    for step in "${plan[@]}"; do
        echo "  ${GREEN}•${NC} $step"
    done

    # --- Alias --------------------------------------------------------------
    if [[ -z "$alias_name" && "$assume_yes" != "true" ]] && [[ -t 0 || -e /dev/tty ]]; then
        echo ""
        echo "${GRAY}A short alias is optional. None is added by default.${NC}"
        echo -n "Add an alias for godev? Type a name, or press Enter to skip: "
        read alias_name < /dev/tty
        alias_name="${alias_name//[[:space:]]/}"
    fi

    if [[ -n "$alias_name" ]]; then
        if [[ ! "$alias_name" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]]; then
            echo "${RED}✗ '${alias_name}' is not a valid alias name${NC}" >&2
            return 1
        fi
        echo ""
        if _godev_warn_alias_collision "$alias_name" "$zshrc"; then
            if [[ "$assume_yes" == "true" ]]; then
                echo "${CYAN}Alias skipped (non-interactive). Add it by hand if you want it.${NC}"
                alias_name=""
            else
                echo -n "${BOLD}Add 'alias ${alias_name}=godev' anyway? (y/N): ${NC}"
                local ans
                read -k 1 ans < /dev/tty
                echo
                if [[ ! "$ans" =~ ^[yY]$ ]]; then
                    echo "${CYAN}Alias skipped${NC}"
                    alias_name=""
                fi
            fi
        else
            echo "  ${GREEN}•${NC} Add: alias ${alias_name}='godev'"
        fi
    fi

    # --- Confirmación -------------------------------------------------------
    if [[ "$assume_yes" != "true" ]]; then
        echo ""
        echo -n "${BOLD}Continue? (y/N): ${NC}"
        local answer
        read -k 1 answer < /dev/tty
        echo
        if [[ ! "$answer" =~ ^[yY]$ ]]; then
            echo "${CYAN}Cancelled. Nothing was changed.${NC}"
            return 0
        fi
    fi

    # --- Backup -------------------------------------------------------------
    local backup="${zshrc}.backup-$(date +%s)"
    if ! cp "$zshrc" "$backup"; then
        echo "${RED}✗ Could not create the backup; aborting without touching your .zshrc${NC}" >&2
        return 1
    fi
    echo "${GRAY}Backup: ${backup}${NC}"

    # --- Reescritura --------------------------------------------------------
    # Quita la función vieja del instalador, nuestro bloque anterior y la línea
    # de integración previa. NO toca aliases escritos a mano por el usuario.
    local tmpfile
    tmpfile=$(mktemp "${zshrc}.new.XXXXXX") || {
        echo "${RED}✗ Could not create the temporary file${NC}" >&2
        return 1
    }

    awk -v marker="$GODEV_INIT_MARKER" -v initline="$GODEV_INIT_LINE" '
        $0 == marker { next }
        $0 == initline { next }
        /^eval "\$\((command )?godev --init zsh\)"$/ { next }
        /^# godev - Function wrapper \(added by installer\)$/ { next }
        /^# Generated by .godev --init zsh. — do not edit by hand\.$/ { next }
        /^# Generado por .godev --init zsh. — no editar a mano\.$/ { next }
        /^godev\(\) \{/ { inblock = 1; next }
        inblock && /^\}[[:space:]]*$/ { inblock = 0; next }
        inblock { next }
        { print }
    ' "$zshrc" > "$tmpfile" || {
        rm -f "$tmpfile"
        echo "${RED}✗ Rewrite failed; your .zshrc is unchanged${NC}" >&2
        return 1
    }

    {
        echo ""
        echo "$GODEV_INIT_MARKER"
        echo "$GODEV_INIT_LINE"
        [[ -n "$alias_name" ]] && echo "alias ${alias_name}='godev'"
    } >> "$tmpfile"

    # Validar que el .zshrc resultante parsea antes de instalarlo
    if ! zsh -n "$tmpfile" 2>/dev/null; then
        rm -f "$tmpfile"
        echo "${RED}✗ The resulting .zshrc has syntax errors; aborting.${NC}" >&2
        echo "${GRAY}  Your original file is unchanged.${NC}" >&2
        return 1
    fi

    if ! mv "$tmpfile" "$zshrc"; then
        rm -f "$tmpfile"
        echo "${RED}✗ Could not write ${zshrc}${NC}" >&2
        return 1
    fi

    echo "${GREEN}✓ Shell integration installed${NC}"

    # --- Shadowing de PATH --------------------------------------------------
    local -a shadows
    shadows=("${(@f)$(_godev_find_shadows)}")
    shadows=(${shadows:#})
    if (( ${#shadows} > 0 )); then
        echo ""
        echo "${YELLOW}${BOLD}⚠ Other godev copies are installed:${NC}"
        local sh
        for sh in "${shadows[@]}"; do
            echo "   ${YELLOW}${sh}${NC}"
        done
        echo ""
        echo "${GRAY}The new wrapper points at ${GODEV_BIN}, so that is the one you will use.${NC}"
        echo "${GRAY}The others are orphaned and may confuse you later.${NC}"
        echo "${GRAY}Review them and remove the ones you do not want. godev deletes nothing.${NC}"
    fi

    echo ""
    if (( ${+functions[godev]} )); then
        # Hay una función godev definida en el shell que invocó esto. Si es la
        # vieja, un `source` la haría interceptar el propio eval de arriba.
        echo "${CYAN}Open a new terminal${NC} ${GRAY}(or: exec zsh)${NC}"
        echo "${GRAY}A plain 'source ~/.zshrc' is not enough: the godev function already${NC}"
        echo "${GRAY}loaded in this session would intercept the new integration.${NC}"
    else
        echo "${CYAN}Reload your shell:${NC} source ~/.zshrc"
    fi
    return 0
}

# Dispatcher de `godev --init [zsh] [--install] [--alias NOMBRE]`
shell_init_command() {
    local shell_name="" do_install="false" alias_name="" assume_yes="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --install) do_install="true" ;;
            --yes|-y)  assume_yes="true" ;;
            --alias)   shift; alias_name="$1" ;;
            zsh|bash|fish|sh) shell_name="$1" ;;
            "") ;;
            *)
                echo "${RED}✗ Unknown argument for --init: $1${NC}" >&2
                echo "${GRAY}  Usage: godev --init [zsh] [--install] [--yes] [--alias NAME]${NC}" >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ "$do_install" == "true" ]]; then
        install_shell_init "$alias_name" "$assume_yes"
        return $?
    fi

    print_shell_init "$shell_name" "$alias_name"
    return $?
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # Verificar que estamos en ZSH
    if [[ -z "$ZSH_VERSION" ]]; then
        echo "${RED}Error: This script requires ZSH${NC}" >&2
        return 1
    fi
    
    # Parsear comandos
    case "$1" in
        --help|-h)
            show_help
            return 0
            ;;
        --version|-v)
            show_version
            return 0
            ;;
        --setup)
            setup_config
            return $?
            ;;
        --list|-l)
            local sort_mode="name"
            local extra_arg=""
            local show_remote="false"
            local show_tree="false"

            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --simple) extra_arg="--simple" ;;
                    --sort-by-commit) sort_mode="commit" ;;
                    --remote) show_remote="true" ;;
                    --tree|-t) show_tree="true" ;;
                    --depth) shift; export GODEV_MAX_DEPTH="$1" ;;
                esac
                shift
            done

            if [[ "$show_tree" == "true" ]]; then
                tree_projects ""
                return $?
            fi
            list_projects "$extra_arg" "$sort_mode" "$show_remote"
            return $?
            ;;
        --cache)
            local do_update="false"
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --update|update) do_update="true" ;;
                    --depth) shift; export GODEV_MAX_DEPTH="$1" ;;
                esac
                shift
            done
            open_html_cache "$do_update"
            return $?
            ;;
        --init)
            shift
            shell_init_command "$@"
            return $?
            ;;
        --update)
            self_update
            return $?
            ;;
        *)
            # Check for flags after the search term
            local search_term="$1"
            local is_list="false"
            local show_remote="false"
            local show_tree="false"
            [[ $# -gt 0 ]] && shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -l) is_list="true" ;;
                    --remote) show_remote="true" ;;
                    --tree|-t) show_tree="true" ;;
                    --depth) shift; export GODEV_MAX_DEPTH="$1" ;;
                esac
                shift
            done

            if [[ "$show_tree" == "true" ]]; then
                tree_projects "$search_term"
                return $?
            fi
            if [[ "$is_list" == "true" ]]; then
                list_projects_with_pattern "$search_term" "$show_remote"
                return $?
            fi

            # Navegación normal
            navigate_to_project "$search_term"
            return $?
            ;;
    esac
}

# Ejecutar main con todos los argumentos
main "$@"
